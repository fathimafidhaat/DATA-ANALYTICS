    "#create a dictionary,add new key-value pair,and remove the newly added item\n",
    "mydict={\n",
    "    \"name\":\"fidha\",\n",
    "    \"place\":\"malappuram\",\n",
    "    \"age\":\"21\"\n",
    "}\n",
    "mydict[\"district\"]=\"malappuram\"\n",
    "print(mydict)\n",
    "mydict.popitem()\n",
    "print(mydict)"
   ]
